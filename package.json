{
  "name": "browserboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Classic board games (checkers, chess) running entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
